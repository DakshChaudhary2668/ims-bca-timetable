{
  "name": "ims-bca-timetable",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.18 || ^24 || ^26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
